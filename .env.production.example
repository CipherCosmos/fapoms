# FAPOMS — production environment template
#
# Copy to `.env` on the production host and fill every value marked REQUIRED.
# The API refuses to start (see assertProductionSafeConfig in packages/backend/src/main.ts)
# if NODE_ENV=production and any of JWT_SECRET, DB_PASSWORD or CORS_ORIGINS is missing or
# left at a development default, or if DB_SYNCHRONIZE is true.

NODE_ENV=production
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=                      # REQUIRED
DB_PORT=5432
DB_USERNAME=                  # REQUIRED — not "postgres"
DB_PASSWORD=                  # REQUIRED — high entropy; boot fails on known defaults
DB_DATABASE=fapoms

# MUST stay false in production.
#
# `true` lets TypeORM rewrite the live schema from the entity classes on every boot, dropping
# any column, index or constraint it does not recognise — no migration, no confirmation, no
# undo. This repository has already lost a unique index to it once. Schema changes go through
# `npm run migration:run`.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Connection pool & resilience. Pool size is PER REPLICA, so with N API replicas the
# database sees up to N × DB_POOL_MAX connections — beyond a few replicas, put PgBouncer
# (transaction pooling) in front and point DB_HOST at it.
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONN_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
# Caps any single query so one runaway statement cannot pin a pooled connection and
# cascade into pool exhaustion. Raise only if a legitimate report genuinely needs longer.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000
# Retry the initial DB connect so a brief database restart at boot doesn't crash the API.
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY_MS=3000

# ── Redis (queues, rate limiting, cache, AND multi-node realtime) ─────────────
# Redis is now on the horizontal-scaling hot path: it backs the Socket.IO adapter
# (cross-replica realtime), the throttler, the RBAC/reference-data caches and upload
# session state, in addition to the Bull queues. Size and monitor it accordingly.
REDIS_HOST=                   # REQUIRED
REDIS_PORT=6379
REDIS_PASSWORD=               # strongly recommended in production
# How long the API waits on any single Redis command before treating Redis as unavailable and
# falling back (cache miss, rate limit skipped, lock not held). Milliseconds. Keep it small: a
# local Redis answers in well under a millisecond, and a Redis outage must degrade the API, not
# hang it. Default 500.
# REDIS_COMMAND_TIMEOUT_MS=500

# The API sits behind Caddy (and Tailscale Funnel), so it must trust X-Forwarded-For to see the
# real client address — otherwise every user is rate-limited as one caller and every audit row
# records the proxy. Default trusts loopback, link-local and private ranges, which is every hop
# this deployment adds and none of the client's. Set to `false` only if there is no proxy at all,
# or to an explicit Express trust-proxy value (e.g. a CIDR list) for a different topology.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# ── Container sizing (read by deploy/docker-compose.prod.yml) ─────────────────────────────────
# Defaults suit a 4 vCPU / ~12 GB host with headroom for on-host image builds. Raise together.
# BACKEND_MEM_LIMIT=1536m
# BACKEND_NODE_OPTIONS=--max-old-space-size=1024   # keep ~500 MB below BACKEND_MEM_LIMIT
# PG_MEM_LIMIT=3g
# REDIS_MAXMEMORY=384mb                            # noeviction: refuses writes rather than losing queue jobs
# REDIS_MEM_LIMIT=512m
# MINIO_MEM_LIMIT=1g

# ── Postgres tuning (read by deploy/docker-compose.prod.yml) ──────────────────────────────────
# Until 2026-08-17 Postgres ran entirely on the image's defaults. Every value below is sized to
# PG_MEM_LIMIT above (3 GB), NOT to the host's 11.5 GB — the same box runs the API, Redis, MinIO
# and the auto-deploy image builds. If you raise PG_MEM_LIMIT, raise shared_buffers and
# effective_cache_size with it; if you lower it, lower them FIRST or Postgres will be OOM-killed
# at startup.
#
# ONE-TIME STEP after the first start with this config — preloading the library is not enough:
#   podman exec fapoms-postgres psql -U "$DB_USERNAME" -d "$DB_DATABASE" \
#     -c 'CREATE EXTENSION IF NOT EXISTS pg_stat_statements;'
# Then `SELECT calls, mean_exec_time, query FROM pg_stat_statements ORDER BY total_exec_time DESC
# LIMIT 20;` answers "what is slow in production?" without reproducing anything by hand.

# Memory. 25% of PG_MEM_LIMIT is the standard starting point for shared_buffers (was 128 MB).
# effective_cache_size is a PLANNER HINT, not an allocation — it is deliberately below the 4 GB
# default because the OS page cache backing this container is charged to the same 3 GB cgroup.
# work_mem is per sort/hash NODE per query, so the true ceiling is this × nodes × concurrency.
# PG_SHARED_BUFFERS=768MB
# PG_EFFECTIVE_CACHE_SIZE=2GB
# PG_WORK_MEM=16MB
# PG_MAINTENANCE_WORK_MEM=256MB
# PG_AUTOVACUUM_WORK_MEM=128MB                     # capped below maintenance_work_mem: 3 workers can run at once

# Storage assumptions. The default random_page_cost of 4 describes a seek on a spinning disk and
# made the planner prefer sequential scans over the restored indexes.
# PG_RANDOM_PAGE_COST=1.1                          # SSD; use 4 if this ever runs on spinning disks
# PG_EFFECTIVE_IO_CONCURRENCY=200                  # SSD queue depth; 1–2 for spinning disks

# JIT. OFF, and this is the single biggest wall-clock win in this block. Measured 2026-08-17 on a
# 3M-row PostGIS ST_DWithin count: 1,550 ms of JIT compilation inside a 1,870 ms query; the same
# query with jit=off took 1,046 ms. PostGIS function costs clear jit_above_cost constantly, so
# nearly every geo query pays to compile an expression tree it then uses once.
# PG_JIT=off

# Autovacuum. Retuned because as of this release something finally deletes rows (see
# packages/backend/src/infrastructure/retention). At the default 20% dead-tuple threshold a table
# of tens of millions of rows never qualifies for vacuum in useful time, so purged space is marked
# reusable and never reclaimed — retention that frees nothing. The cost limit is the other half:
# at the default 200 a worker cannot keep pace with the purge feeding it.
# PG_AUTOVACUUM_SCALE_FACTOR=0.05
# PG_AUTOVACUUM_COST_LIMIT=1000

# WAL. Batched deletes plus post-checkpoint full-page writes make retention the WAL-heaviest thing
# this database does. A larger max_wal_size trades pg_wal disk for fewer checkpoints; compression
# trades a little CPU for materially less WAL reaching the disk. Budget ~2× PG_MAX_WAL_SIZE of
# free space on the pgdata volume.
# PG_MAX_WAL_SIZE=2GB
# PG_MIN_WAL_SIZE=512MB
# PG_WAL_COMPRESSION=on

# Observability. Slow-query logging was off entirely (log_min_duration_statement=-1). 1000 ms is
# chosen to stay quiet on a healthy system — the point is a log that gets read. Container logs are
# capped at 20 MB × 5 by the compose file, so lowering this materially shortens log retention.
# PG_LOG_MIN_DURATION_MS=1000
# PG_LOG_AUTOVACUUM_MIN_DURATION_MS=10000          # 0 logs every autovacuum; -1 disables
# PG_TRACK_IO_TIMING=on                            # real I/O times in EXPLAIN (BUFFERS); check pg_test_timing if virtualised
# PG_PRELOAD_LIBRARIES=pg_stat_statements
# PG_STAT_STATEMENTS_MAX=5000
# PG_STAT_STATEMENTS_TRACK=top                     # 'all' also tracks statements inside functions

# ── Data retention (read by packages/backend/src/infrastructure/retention) ────────────────────
# Until 2026-08-17 NOTHING in FAPOMS was ever deleted. A scheduled, batched purge now runs hourly
# at :10 IST over four tables. All values are in DAYS; 0 switches that purge off entirely.
#
# It never touches audit_events (the compliance record), the operational history tables, an
# UNDISPATCHED outbox row, or an UNREAD notification — those are all either evidence or
# outstanding work. See the class comment on RetentionService for the full list and reasoning.

# Outbox rows that have been dispatched. The relay's own retry budget is ~15 minutes, so a week is
# far beyond it; it exists so "did that event go out on Tuesday?" is answerable during the week.
# RETENTION_OUTBOX_DAYS=7

# Refresh tokens, counted PAST expiry. Rotation inserts a row per refresh (~96/device/day against
# a 15-minute access token) and nothing had ever removed one. A revoked token still carries its
# original expiry, so this one window covers "expired" and "revoked" together — and the few days
# before it applies are what "when did this device last authenticate, and from where?" is answered
# from after a logout.
# RETENTION_REFRESH_TOKEN_GRACE_DAYS=2

# Notifications that have been READ. Unread ones are never purged at any age. Note that
# notifications.dedupe_key is UNIQUE and deleting an old one frees its key — so a condition that
# is still true (a credential expiring for seven months that nobody renewed) will notify again.
# That is why this is 180 days and not 30.
# RETENTION_READ_NOTIFICATION_DAYS=180

# The movement trail behind travel claims. Also settable — and preferably set — at
# Administration → Platform Settings → Data retention, which wins over this variable.
#
# 550 days ≈ 18 months, and the number is not arbitrary. The trail is LIVE evidence, not an
# archive: the travel assessment on an assignment is recomputed from the raw fixes every time
# somebody opens it, so the window has to outlast the period in which a claim can still be
# questioned. An audit performed on 2 April falls in the first days of an Indian financial year
# whose books are typically not closed and audited until well into the following calendar year;
# 12 months would delete the evidence months before anyone could be asked about it.
#
# It is not longer because each extra month is ~0.8 GB at 200 audits/day (~7.8 GB at 2,000), and
# because indefinitely retaining minute-by-minute location history of identifiable workers is its
# own liability — the risk runs both ways.
#
# Set to 0 to keep the trail forever. That was the previous behaviour, and it stays reachable on
# purpose: an organisation whose policy really is "keep indefinitely" must be able to say so, which
# is a different thing from never having been asked.
# LOCATION_TRAIL_RETENTION_DAYS=550

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. At least 32 characters of high-entropy randomness, e.g.
#   openssl rand -base64 48
# Anyone holding this value can mint a valid token for any role.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Signs time-limited document download links. Defaults to JWT_SECRET when unset; a separate
# value is better, so a leaked download link cannot be turned into a session token.
DOCUMENT_TOKEN_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED. Comma-separated exact origins of the web frontend. No trailing slash, no
# wildcards — credentials are enabled on this API, so a wildcard would let any site call it
# with the user's cookies.
CORS_ORIGINS=https://fapoms.example.com
FRONTEND_URL=https://fapoms.example.com

# ── Object storage (audit documents) ──────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=                  # REQUIRED for self-hosted MinIO; omit for real AWS S3
S3_BUCKET_NAME=               # REQUIRED
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=            # REQUIRED
AWS_SECRET_ACCESS_KEY=        # REQUIRED
S3_FORCE_PATH_STYLE=true      # true for MinIO, false for AWS S3
MAX_FILE_SIZE=52428800
# Server-side encryption at rest for the bucket (audit evidence + KYC files). Applied to the bucket
# default on boot and to server-side PUTs. AES256 (SSE-S3) works on AWS and MinIO; use aws:kms +
# STORAGE_SSE_KMS_KEY_ID for a customer-managed key on AWS.
STORAGE_SSE=AES256
STORAGE_SSE_KMS_KEY_ID=
# Max accepted upload size (MB) for the presigned document path. Default 50.
DOCUMENT_MAX_UPLOAD_MB=50

# ── Malware scanning (ClamAV) ─────────────────────────────────────────────────
# Every file that enters the app — attachments, documents, KYC photos, Excel imports, chunked and
# presigned uploads — is streamed to clamd (INSTREAM) and rejected on a signature hit. Run clamav as
# a sidecar and point these at it. The EICAR test file is always caught even with no scanner set.
CLAMAV_HOST=            # e.g. clamav ; leave blank to disable (uploads pass with a loud warning)
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# Set true to FAIL CLOSED — refuse any upload that cannot be scanned (recommended for production).
FILE_SCAN_REQUIRED=false

# ── Performance ───────────────────────────────────────────────────────────────
# The operations dashboard's org-wide aggregate bundle (7 heavy queries) is cached cluster-wide for
# this many seconds, so it runs at most once per interval instead of once per user per load. Lower it
# for fresher dashboards, raise it to shed more DB load under heavy concurrency.
DASHBOARD_CACHE_TTL_S=15
# Same cluster-wide caching for the other heavy aggregate views: the HR workforce overview (~22 queries)
# and the Command Room coverage map (loads all branches + assayers). Both change slowly.
HR_OVERVIEW_CACHE_TTL_S=30
COMMAND_CENTER_CACHE_TTL_S=20

# ── Resilience / limits ───────────────────────────────────────────────────────
# Max JSON request body. Kept high only for the legacy base64-JSON document upload; if you use the
# binary/chunked upload endpoints instead, shrink this (e.g. 2mb) to reduce the JSON DoS surface.
MAX_JSON_BODY=50mb
# Hard timeout (ms) for calls to the external OSRM routing server before falling back to PostGIS, so a
# slow routing service can't freeze planning.
OSRM_TIMEOUT_MS=4000
# Circuit breaker around OSRM: after this many consecutive failures it stops calling OSRM and uses
# PostGIS directly for the cooldown window (then probes once for recovery) — so a sustained routing
# outage doesn't make every request pay the timeout.
OSRM_BREAKER_THRESHOLD=5
OSRM_BREAKER_COOLDOWN_MS=30000
# HTTP server timeouts. headersTimeout defends against slow-loris clients; keepAliveTimeout should
# EXCEED your load balancer's idle timeout to avoid the connection-reuse race; requestTimeout stays
# generous so slow field-network uploads still finish (shrink where uploads go direct-to-storage).
HTTP_KEEPALIVE_TIMEOUT_MS=61000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_REQUEST_TIMEOUT_MS=300000
# Object storage: retry transient failures and fail fast when storage is unreachable (connection only;
# large transfers are never aborted mid-stream).
S3_MAX_ATTEMPTS=3
S3_CONNECTION_TIMEOUT_MS=5000

# ── Sensitive-data encryption at rest (DPDP Act) ──────────────────────────────
# REQUIRED in production. Encrypts PAN, bank account and government-ID *numbers* in the database
# (AES-256-GCM). 64 hex chars or a 32-byte base64 string, e.g.  openssl rand -hex 32
# If unset, those fields are stored UNENCRYPTED and the API logs a loud warning at boot.
# Losing this key makes already-encrypted values unrecoverable — store it in a secrets manager.
PII_ENCRYPTION_KEY=

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────────────
# Without these the backend stores notifications but cannot deliver them to handsets;
# assayers then only see alerts when the app is open.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Geo / routing ─────────────────────────────────────────────────────────────
# Travel distance drives assignment fees. Without a key the routing provider falls back to
# straight-line distance, which under-states real road travel and therefore under-pays
# assayers on winding routes.
GOOGLE_MAPS_API_KEY=
ROUTING_PROVIDER=google

# ── Horizontal scaling, caching & process role ────────────────────────────────
# Role of this replica set:
#   all    (default) — serves HTTP AND runs background jobs + crons. Use for single-
#                      process and dev deployments; behaviour is unchanged from before.
#   api    — serves HTTP only; background jobs are paused locally and run on workers.
#   worker — runs background jobs + scheduled crons only; serves no HTTP.
# Split api/worker to scale request handling and heavy jobs (OCR, dispatch, SLA sweeps,
# notification delivery) independently. If ANY replica is set to 'api', you MUST run at
# least one 'worker' (or 'all') replica, or queued jobs will never be processed.
PROCESS_ROLE=all

# TTL (seconds) for the cached per-request auth principal, which removes a 5-join query
# from every authenticated request. Short by design: role changes / suspensions are
# invalidated immediately via events; this only bounds the worst case if one is missed.
RBAC_CACHE_TTL_SECONDS=30

# Multi-node realtime uses the Socket.IO Redis adapter automatically when REDIS_HOST is set.
# If the websocket 'polling' transport is enabled, also enable sticky sessions at the LB.

# ── Observability & admin-UI security ─────────────────────────────────────────
# Prometheus scrape endpoint: GET /api/v1/metrics. Set a token to require
# `Authorization: Bearer <METRICS_TOKEN>` (Prometheus `bearer_token`). Leave unset ONLY if
# you restrict /metrics at the network layer instead.
METRICS_TOKEN=
# Bull Board job dashboard at /bull-board exposes job payloads (document/assayer ids,
# notification content) and job controls. In production it is NOT mounted unless BOTH of
# these are set — then it requires HTTP Basic Auth.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
# Readiness probe GET /api/v1/health/ready (DB + Redis) — keep on your internal subnet.


# ── Application-owned configuration — do NOT set these here ─────────────────
# Email delivery (Gmail or SMTP, sender address, public URL), the morning-brief schedule,
# platform fee defaults, tax rates, the expense-claim ceiling and movement-record retention are
# all configured in the running application at Administration → Platform Settings.
#
# They need no variables in this file. Values saved in the app take effect immediately, record
# who changed them, and store credentials encrypted — which is why PII_ENCRYPTION_KEY above is
# required before a mail password can be saved there.
#
# The corresponding variables still work as a bootstrap fallback for a brand-new environment;
# see packages/backend/.env.example for the full list and precedence.
