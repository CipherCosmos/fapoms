# Optional. Installed to ~/.config/fapoms/deploy.env on the homeserver.
#
# Every value auto-deploy.sh needs on this host is already its default — `main`, ~/apps/fapoms,
# ~/apps/fapoms-ops, rootless podman, deploy/docker-compose.prod.yml. Nothing here is required;
# the file exists so there is somewhere to put a token, and somewhere to look when the answer to
# "what does this box deploy?" needs to be explicit rather than implied by a default.
#
# `KEY=value`, quotes around any value containing a space.

FAPOMS_BRANCH=main

# OPTIONAL while the repository is public — the CI gate's check-runs call works anonymously.
# A token only lifts the GitHub API rate limit from 60 requests an hour to 5000, counted per
# source IP. Set one if the repo is ever made private: private + no token is an HTTP 404, and
# the gate then refuses on every tick, forever, while the app keeps serving the old build.
FAPOMS_GH_TOKEN=
