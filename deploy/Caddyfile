# One origin in front of the whole application.
#
# The web app calls the API on RELATIVE paths (`/api`, `/socket.io`) — its dev server proxies
# them, and in production something has to play that role or every request goes to the static
# host and 404s. That is this file's job: same origin, so no CORS, and nothing about where the
# API lives baked into the JS bundle at build time.
#
# Listens on :8080, not :80, because it runs as a rootless container and rootless cannot bind
# privileged ports. Nothing is lost: Tailscale Funnel terminates TLS on :443 publicly and
# forwards here, so the port this binds is an internal detail.

{
	admin off

	# Funnel terminates TLS and speaks plain HTTP to us. Without this, Caddy would try to obtain
	# its own certificate for a hostname it does not control and fail on every request.
	auto_https off

	# `servers` is a GLOBAL option. It was first written inside the site block below, where Caddy
	# rejects it outright — "unrecognized directive: servers" — and the container exit-loops
	# before serving anything.
	servers {
		# Tailscale forwards from a private address; without this the real client IP is lost and
		# every request appears to come from the proxy.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode gzip

	# --- API and realtime --------------------------------------------------------------------
	# WebSockets need no special directive in Caddy v2 — reverse_proxy upgrades automatically.
	handle /api/* {
		reverse_proxy backend:3000
	}
	handle /socket.io/* {
		reverse_proxy backend:3000
	}
	handle /livekit/* {
		reverse_proxy backend:3000
	}

	# --- APK distribution ---------------------------------------------------------------------
	# One stable link to hand to a field assayer: https://<host>/download/app.apk
	#
	# Only ever needed for the FIRST install and for native changes — everything else reaches the
	# handset over the air.
	#
	# The link itself is a REDIRECT to wherever the current build is hosted, not a file served
	# from this box. This machine sits behind a residential connection: measured, it pushes about
	# 1 MB/s to a downloader (a 107 MB APK ≈ 2 minutes) and every simultaneous download shares
	# that one upload line — and getting a new build onto the box in the first place ran at
	# ~9 KB/s, an hour-plus per release. EAS Build already hosts every finished APK on a CDN the
	# moment it completes; the file is born there. Pointing the stable link at it makes the
	# download CDN-fast, takes the home line out of the path entirely, and turns "publish a
	# build" from a 107 MB transfer into writing one URL.
	#
	# `apk-redirect.caddy` is generated by deploy/publish-apk.sh and holds only that URL. It is
	# imported here (a snippet is the one way Caddy will take a value from a file), so a new
	# build is: run the script, restart caddy — the same restart auto-deploy.sh already does for
	# any Caddyfile change. If the snippet is absent, `import` of a missing file is an error, so
	# it is written once with a local-file fallback and kept in place forever.
	handle /download/app.apk {
		import /etc/caddy/apk-redirect.caddy
	}
	# Anything else under /download/ (an explicitly named older build, say) still comes off disk.
	handle /download/* {
		root * /srv/fapoms-downloads
		uri strip_prefix /download
		# Android will not install a file served as text/plain.
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment"
		file_server browse
	}

	# --- Everything else is the web app -------------------------------------------------------
	# The frontend image handles SPA fallback internally (try_files → index.html), so a deep link
	# forwarded here returns the app rather than a 404.
	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format console
	}
}
