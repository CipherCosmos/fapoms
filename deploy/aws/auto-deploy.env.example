# Installed to /etc/default/fapoms-deploy. Read twice: systemd loads it as the service's
# EnvironmentFile, and auto-deploy.sh sources it directly so a manual run behaves identically to
# a timer run. Keep it in `KEY=value` form with quotes around any value containing a space —
# that is the intersection of what both readers accept.

# Which branch this host deploys. The AWS box follows `test`, where the features under test live;
# the homeserver follows `main`. Same script, same gate, different branch.
FAPOMS_BRANCH=test

FAPOMS_REPO=/opt/fapoms
FAPOMS_OPS_DIR=/opt/fapoms-ops
FAPOMS_ENV_FILE=/opt/fapoms/.env.docker

# Ubuntu on EC2 runs docker; the homeserver runs rootless podman.
FAPOMS_CONTAINER_CLI=docker

# In `-f` order. For a box bootstrapped with MODE=full, append the overlay:
#   FAPOMS_COMPOSE_FILES="/opt/fapoms/deploy/docker-compose.aws.yml /opt/fapoms/deploy/aws/docker-compose.aws-full.yml"
FAPOMS_COMPOSE_FILES=/opt/fapoms/deploy/docker-compose.aws.yml

# Re-derives docker-compose.aws.yml from docker-compose.prod.yml after each reset. Without this
# the box keeps running whatever stack shape bootstrap generated on the day it was installed.
FAPOMS_POST_RESET_HOOK=/opt/fapoms-ops/render-aws-compose.sh

# Caddy binds 127.0.0.1:8080; host nginx fronts it on :80.
FAPOMS_HEALTH_URL=http://127.0.0.1:8080/api/v1/health

FAPOMS_GH_REPO=CipherCosmos/fapoms

# OPTIONAL while the repository is public — the CI gate's check-runs call works anonymously.
# A token only lifts the GitHub API rate limit from 60 requests an hour to 5000, and the limit
# is counted per source IP rather than per repository. Worth setting if this box shares an
# egress IP with anything else that talks to the API, or if the repo is ever made private
# (private + no token = HTTP 404, and the gate then refuses on every tick, forever).
FAPOMS_GH_TOKEN=
