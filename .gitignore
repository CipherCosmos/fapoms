# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
out/
.next/

# Logs & Environment Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.docker
!.env.docker.example

# Backups of the env file, whatever they are called.
#
# `.env.docker` itself is ignored above, but a timestamped copy of it is not, and those get made
# — by hand before an edit, and by `deploy/auto-deploy.sh`. One was sitting untracked in this
# repository holding seven live secrets (JWT signing key, database password, the PII encryption
# key) and would have been committed by the next `git add -A`. The pattern matters more than the
# one file: a secret leaks once and is burned for ever, and `assertProductionSafeConfig` already
# has to permanently refuse two values for exactly that reason.
.env*.bak
.env*.bak-*
.env.*.backup

# Runtime caches written next to the code rather than into a volume. `var/geo-cache` is the
# geocoder's on-disk memo; it is derived data, it grows without bound, and it is per-machine.
var/

# Worktrees created for background agent sessions.
.claude/worktrees/

# IDE & OS Files
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads & Temp Files
uploads/
**/uploads/
tmp/
**/tmp/
temp/
*.tmp

# Test artifacts & Reports
test-results/
playwright-report/
blob-report/
coverage/
evidence/
release-artifacts/

# Android bug reports. One of these (9.5 MB) was committed to the repository root and
# downloaded by every clone for three weeks before anyone noticed it was there.
bugreport-*.zip

# Test spreadsheets & Excel dumps
*.xlsx
*.xls

# Geocoding cache (auto-generated, machine-specific)
**/geocoding-cache.json

# Firebase config files (root copies)
google-services.json
GoogleService-Info.plist
service-account-key.json
*-firebase-adminsdk-*.json

# Mobile platform build dirs — `expo prebuild` output only.
# Anchored to the generated directories rather than a bare `android/`, which matched every
# directory of that name at any depth and silently excluded the hand-written native source
# under packages/mobile/modules/*/android/.
.expo/
/packages/mobile/android/
/packages/mobile/ios/

# Compiled output must never sit beside the sources in packages/shared/src: a NodeNext
# `./enums.js` import resolves to the stale artifact instead of enums.ts, so every export
# added after the last stray compile appears missing. Build output belongs in dist/.
packages/shared/src/*.js
packages/shared/src/*.js.map
packages/shared/src/*.d.ts

# TypeScript incremental build cache. Tracked by accident: it is regenerated by every build, so
# it showed up as a change on every machine and produced a merge conflict in a file no human has
# ever read.
*.tsbuildinfo

# Points EAS Build at the local release keystore (an absolute, machine-specific path) so a
# cloud build is signed with the same key as a local `./gradlew assembleRelease` — committing
# it would both leak that path and go stale the moment anyone builds from a different machine.
packages/mobile/credentials.json
.neon
