# =============================================================================
# FAPOMS — environment reference (copy to .env.docker and fill in)
#
# Database and object storage are BOTH fully switchable by env — no provider is
# hardcoded. Pick ONE profile in each of the two sections below and paste its
# lines in. To switch later (Neon <-> MinIO <-> AWS S3 <-> local), just swap the
# block and restart. Secrets never live in this example file.
# =============================================================================

NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — choose ONE profile
# The app prefers DATABASE_URL when set; otherwise it uses the discrete DB_* vars.
# DB_SSL=true turns on TLS (required by Neon and most managed Postgres).
# ─────────────────────────────────────────────────────────────────────────────

# --- Profile A: Neon (managed, serverless Postgres) ---
# DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require
# DB_SSL=true
# (For migrations the CLI prefers DATABASE_URL_UNPOOLED if you also set it.)
# DATABASE_URL_UNPOOLED=postgresql://<user>:<pass>@<direct-host>/<db>?sslmode=require

# --- Profile B: local / self-hosted Postgres (the docker `postgres` service) ---
# DB_HOST=postgres
# DB_PORT=5432
# DB_USERNAME=fapoms
# DB_PASSWORD=change-me
# DB_DATABASE=fapoms
# DB_SSL=false

# --- Profile C: AWS RDS / other managed ---
# DATABASE_URL=postgresql://<user>:<pass>@<rds-endpoint>:5432/<db>
# DB_SSL=true

DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true   # app applies pending migrations on boot; set false with >1 replica

# ─────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE — choose ONE profile
# STORAGE_DRIVER selects the engine; the S3_* / AWS_* vars configure it.
# forcePathStyle must be TRUE for Neon and MinIO, FALSE for real AWS S3.
# ─────────────────────────────────────────────────────────────────────────────

# --- Profile A: Neon Object Storage (S3-compatible, path-style + SigV4) ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<branch>.storage.<cell>.<region>.aws.neon.tech
# S3_BUCKET_NAME=fapoms
# S3_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=<neon branch key>
# AWS_SECRET_ACCESS_KEY=<neon branch secret>

# --- Profile B: MinIO (the docker `minio` service) ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET_NAME=fapoms-documents
# S3_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=fapoms_minio
# AWS_SECRET_ACCESS_KEY=change-me

# --- Profile C: AWS S3 (real) — no endpoint, virtual-hosted, IAM role preferred ---
# STORAGE_DRIVER=s3
# S3_BUCKET_NAME=fapoms-documents-<accountid>
# S3_FORCE_PATH_STYLE=false
# AWS_REGION=ap-south-1
# (no keys — use the instance/task IAM role)

# --- Profile D: local disk (tests / bare-metal fallback) ---
# STORAGE_DRIVER=local

# ─────────────────────────────────────────────────────────────────────────────
# The rest (fill in per environment) — secrets go in the real .env.docker only.
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

JWT_SECRET=
PII_ENCRYPTION_KEY=
DOCUMENT_TOKEN_SECRET=

# Push (Firebase FCM)
FCM_PROJECT_ID=fapoms-gss
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Email (Amazon SES SMTP or Gmail)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Maps / geocoding / routing (all optional / external)
GOOGLE_MAPS_API_KEY=
NOMINATIM_URL=
OSRM_URL=

# Upload virus scanning (ClamAV) — optional
FILE_SCAN_REQUIRED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ── Mobile dev container (docker-compose.yml `mobile` service) ────────────────
# The address the Expo dev client and the app itself call. Both must be an IP the PHONE can
# reach — "localhost" resolves to the phone, not your machine — so use the LAN IP of the host
# running this stack.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10
EXPO_PUBLIC_DEV_LOCATION=192.168.1.10

# ── Postgres statement statistics (docker-compose.yml) ────────────────────────
# pg_stat_statements is what makes "which query is slow" answerable at all. Changing
# PG_PRELOAD_LIBRARIES needs a container RESTART, not a reload: shared_preload_libraries is
# PGC_POSTMASTER, so until the container is recreated the extension exists but collects nothing.
PG_PRELOAD_LIBRARIES=pg_stat_statements
PG_STAT_STATEMENTS_MAX=5000
PG_STAT_STATEMENTS_TRACK=top
PG_TRACK_IO_TIMING=on
