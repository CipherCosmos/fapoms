# =============================================================================
# FAPOMS — Docker Environment Configuration
# Used by docker-compose.yml for all services
# =============================================================================

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (matches the 'postgres' service name in docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=fapoms
DB_PASSWORD=
DB_DATABASE=fapoms
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (matches the 'redis' service name in docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Object Storage (MinIO — S3-compatible, runs in Docker as fapoms-minio)
# All binary files (PDFs, Excel, images, chat attachments) are stored in MinIO.
# Never stored in the local filesystem or Docker volume bind-mounts.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=fapoms-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE=52428800

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Firebase Cloud Messaging
FCM_PROJECT_ID=fapoms-gss
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Google Maps (live traffic, turn-by-turn, transit, fare, dynamic reroute)
# Also the SOLE geocoder + type-ahead source (Geocoding API + Places API New for
# geocoding/autocomplete) — no free-tier fallbacks.
# Get from: https://console.cloud.google.com → APIs & Services → Credentials → API key
GOOGLE_MAPS_API_KEY=
