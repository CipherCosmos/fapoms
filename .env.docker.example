# =============================================================================
# FAPOMS — Docker Environment Configuration
# Used by docker-compose.yml for all services
# =============================================================================

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (matches the 'postgres' service name in docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=fapoms
DB_PASSWORD=
DB_DATABASE=fapoms
# Migrations are the schema authority — never `synchronize`.
#
# This was `true`, and it is how the migration chain came to be unrunnable: TypeORM rewrote the
# schema from the entities on every boot, so nobody needed the migrations and nobody noticed they
# had stopped working. Verified: the historical chain built 2 of 83 tables before aborting.
# `1784000000000-BaselineSchema` replaced it and is proven to build the system from empty.
#
# Turning this back on re-creates that situation silently — the schema drifts from the migrations
# with no error and no diff, until the next deploy to a fresh database fails.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis (matches the 'redis' service name in docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Object Storage (MinIO — S3-compatible, runs in Docker as fapoms-minio)
# All binary files (PDFs, Excel, images, chat attachments) are stored in MinIO.
# Never stored in the local filesystem or Docker volume bind-mounts.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=fapoms-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE=52428800

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Firebase Cloud Messaging
FCM_PROJECT_ID=fapoms-gss
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Routing (road distance / travel time between branch and assayer). OSRM by default, against the
# OSRM project's public demo server — no SLA; a great-circle estimate, labelled as such, answers
# whenever the router can't. Point OSRM_URL at a self-hosted osrm/osrm-backend to upgrade, or set
# ROUTING_PROVIDER=POSTGIS for straight-line estimates only (no outbound calls). Timeout, cache
# TTL, batch size and circuit-breaker knobs are documented in .env.production.example.
ROUTING_PROVIDER=OSRM
OSRM_URL=https://router.project-osrm.org

# Google Maps — optional, geocoding only (not routing). When set, the Geocoding API is the first
# tier of the branch/assayer geocoder and the Places API (New) answers the place type-ahead.
# Without it, geocoding uses the free OpenStreetMap tiers, then pincode/district centroids, and
# the type-ahead returns nothing.
# Get from: https://console.cloud.google.com → APIs & Services → Credentials → API key
GOOGLE_MAPS_API_KEY=

# Error alerting (optional). When set, an unexpected 500 pushes a notification here so a fault is
# noticed by a person rather than waiting in a log nobody reads.
#
# Any endpoint accepting a plain-text POST works — ntfy needs no account at all:
#   ALERT_WEBHOOK_URL=https://ntfy.sh/<a-long-random-topic-you-choose>
#
# The alert carries the route, the HTTP method, the exception's class name and the correlation id,
# and deliberately nothing else. Exception messages on this system routinely contain the data that
# caused them — a failing query includes its values, and those values are customer records — so the
# alert says where to look and the detail stays in the log on the host. Repeats are collapsed to one
# per fifteen minutes and capped at ten alerts per window.
#
# Note that an ntfy topic is a public URL: anyone who knows it can read the alerts. Choose a long
# random topic name, or self-host, and treat it as a secret.
ALERT_WEBHOOK_URL=
