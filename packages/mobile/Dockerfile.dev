# =============================================================================
# FAPOMS Mobile — Development Dockerfile (Hot Reload / Expo Web)
# =============================================================================
# Uses Expo dev server in web mode for browser-based mobile preview.
# Source files are bind-mounted from the host via docker-compose volumes.
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# ---- 1. Copy workspace root files for npm workspaces ----
COPY package.json package-lock.json ./

# ---- 2. Copy all package.json files (for dependency resolution) ----
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/mobile/package.json ./packages/mobile/

# ---- 3. Install ALL workspace dependencies ----
# --no-audit: skips the network-heavy audit step (saves time and bandwidth).
# npm cache clean --force: removes the tarball cache in the same RUN layer so
# it is never committed to the image layer, reducing image size by ~200-400 MB.
RUN npm install --legacy-peer-deps --no-audit \
    && npm cache clean --force

# ---- 4. Fix React version conflict ----
# The workspace root hoists React 19 (from frontend) to /app/node_modules/.
# Mobile needs React 18 (in /app/packages/mobile/node_modules/).
# If both exist, Metro bundles BOTH, causing "Objects are not valid as a
# React child" crashes. Remove the hoisted React 19 so only React 18 remains.
RUN rm -rf /app/node_modules/react /app/node_modules/react-dom \
           /app/node_modules/scheduler

# ---- 5. Copy and build the shared package ----
COPY packages/shared/ ./packages/shared/
RUN npm run build:shared

# ---- 6. Copy mobile source ----
COPY packages/mobile/ ./packages/mobile/

WORKDIR /app/packages/mobile

# NOTE: No second npm install needed here — workspace root install at step 3
# already resolved and linked all mobile-specific packages. Running it again
# would download ~300 MB of duplicate tarballs and waste significant disk space.

EXPOSE 8081

# Expo 52 LAN host mode: binds Metro bundler to 0.0.0.0 inside container
CMD ["npx", "expo", "start", "--host", "lan", "--port", "8081"]