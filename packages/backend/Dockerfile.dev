# =============================================================================
# FAPOMS Backend — Development Dockerfile (Hot Reload)
# =============================================================================
# Uses nest start --watch for automatic recompilation on file changes.
# Source files are bind-mounted from the host via docker-compose volumes.
# =============================================================================

FROM node:22-alpine

# Install OS-level deps for native modules (bcrypt, pg) and the pg_dump client the data-reset
# feature's on-demand backup shells out to (see infrastructure/data-reset/backup-on-demand.service.ts).
RUN apk add --no-cache python3 make g++ postgresql16-client

WORKDIR /app

# ---- 1. Copy workspace root files for npm workspaces ----
COPY package.json package-lock.json ./

# ---- 2. Copy all package.json files (for dependency resolution) ----
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/mobile/package.json ./packages/mobile/

# ---- 3. Install ALL workspace dependencies ----
RUN npm install --legacy-peer-deps && \
    npm rebuild bcrypt --build-from-source

# ---- 4. Copy and build the shared package ----
COPY packages/shared/ ./packages/shared/
RUN npm run build:shared

# ---- 5. Copy backend source (will be overridden by bind mount in dev) ----
COPY packages/backend/ ./packages/backend/

WORKDIR /app/packages/backend

EXPOSE 3000

# nest start --watch: recompiles TypeScript and restarts on every file change
CMD ["npx", "nest", "start", "--watch"]
