# FAPOMS Backend Environment Configuration
# Copy to .env.local and fill in actual values

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fapoms
DB_PASSWORD=fapoms_dev
DB_DATABASE=fapoms
# Migrations are the schema authority — never `synchronize`.
#
# This was `true`, and it is how the migration chain came to be unrunnable: TypeORM rewrote the
# schema from the entities on every boot, so nobody needed the migrations and nobody noticed they
# had stopped working. Verified: the historical chain built 2 of 83 tables before aborting.
# `1784000000000-BaselineSchema` replaced it and is proven to build the system from empty.
#
# Turning this back on re-creates that situation silently — the schema drifts from the migrations
# with no error and no diff, until the next deploy to a fresh database fails.
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=52428800

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=fapoms-gss
FCM_CLIENT_EMAIL=your-service-account-email@fapoms-gss.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Maps — optional, geocoding only (routing is OSRM; see ROUTING_PROVIDER / OSRM_URL in
# .env.production.example). When set, the Geocoding API is the first tier of the branch/assayer
# geocoder and the Places API (New) answers the place type-ahead. Enable both APIs on the Google
# Cloud project and attach a billing account. Without it, geocoding falls through the free
# OpenStreetMap tiers and then pincode/district centroids, and the type-ahead returns nothing.
GOOGLE_MAPS_API_KEY=

# Outbound email (staff notifications + morning digest).
#
# THE PRIMARY PLACE TO CONFIGURE THIS IS THE APP: Administration → Platform Settings →
# Email delivery. Values saved there win over anything set here, take effect without a
# restart, and store the password encrypted. Use these variables only for bootstrapping a
# fresh environment, or when you would rather the credential never reached the database.
#
# Saving a password in the UI requires PII_ENCRYPTION_KEY to be set below — without it the
# app refuses rather than storing a credential in the clear.
#
# Preferred: a Google Workspace account with 2-step verification ON and an App Password
# minted at https://myaccount.google.com/apppasswords (select "Mail"). Ordinary account
# passwords do NOT work over SMTP.
#   GMAIL_USER=it@sumeruglobal.in
#   GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Any other SMTP provider works via the generic variables instead:
#   SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=...  SMTP_PASSWORD=...  SMTP_SECURE=false
# Neither set, and nothing saved in the UI = email disabled: notifications still reach the
# in-app bell and each row records that its email was suppressed. Nothing breaks.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display sender, e.g. "FAPOMS <it@sumeruglobal.in>". Defaults to the account itself.
EMAIL_FROM=
# Base URL used for links inside emails (the web app the recipient opens).
APP_PUBLIC_URL=http://localhost:5173
# When the morning digest email goes out (cron, Asia/Kolkata). Default 08:30 Mon-Sat.
# Also editable at Platform Settings → Schedules, which reschedules it without a restart.
EMAIL_DIGEST_CRON=30 8 * * 1-6

# ── Business policy: configure these in the app, not here ────────────────────────────────
# Administration → Platform Settings owns the default audit fee, the fallback travel rate and
# free-commute allowance, the fee-warning threshold, TDS withholding, the largest single
# expense claim, and movement-record retention. Each falls back to the variable named beside
# it in the UI if it is set here, but the app is the place to change them — a value saved
# there takes effect immediately and records who changed it.
#   FEE_FLAG_MULTIPLIER, LOCATION_TRAIL_RETENTION_DAYS
