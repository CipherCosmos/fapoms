# FAPOMS Backend Environment Configuration
# Copy to .env.local and fill in actual values

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fapoms
DB_PASSWORD=fapoms_dev
DB_DATABASE=fapoms
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=52428800

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=fapoms-gss
FCM_CLIENT_EMAIL=your-service-account-email@fapoms-gss.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Maps (primary geocoder + place autocomplete)
# Enable the "Geocoding API" and the "Places API (New)" on the Google Cloud project,
# attach a billing account, and put the API key here. Without it the backend
# falls back to the free Nominatim (OpenStreetMap) geocoder.
GOOGLE_MAPS_API_KEY=

# Geoapify (temporary free-tier geocoder, ~3000 req/day)
# Used between Google and Nominatim until the Google key is configured.
GEOCODER_API_KEY=
