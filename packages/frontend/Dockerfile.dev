# =============================================================================
# FAPOMS Frontend — Development Dockerfile (Hot Reload)
# =============================================================================
# Uses Vite dev server with HMR for instant browser updates on file changes.
# Source files are bind-mounted from the host via docker-compose volumes.
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# ---- 1. Copy workspace root files for npm workspaces ----
COPY package.json package-lock.json ./

# ---- 2. Copy all package.json files (for dependency resolution) ----
# Mobile is excluded — frontend only resolves shared + backend peer deps at the root.
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/

# ---- 3. Install ALL workspace dependencies ----
# --no-audit: skips the network-heavy audit step (saves time and bandwidth).
# The arch check installs the correct platform-specific Rollup native binding:
#   - aarch64 → arm64-musl (Alpine)
#   - x86_64  → x64-musl   (Alpine)
# This fixes a hard-coded arm64 install that would fail on x86 production servers.
# npm cache clean --force: removes the tarball cache in the same RUN layer so
# it is never committed to the image layer, reducing image size by ~200-400 MB.
RUN npm install --legacy-peer-deps --no-audit \
    && if [ "$(uname -m)" = "aarch64" ]; then \
         npm install @rollup/rollup-linux-arm64-musl --no-save --legacy-peer-deps --no-audit; \
       elif [ "$(uname -m)" = "x86_64" ]; then \
         npm install @rollup/rollup-linux-x64-musl --no-save --legacy-peer-deps --no-audit; \
       fi \
    && npm cache clean --force

# ---- 4. Copy and build the shared package ----
COPY packages/shared/ ./packages/shared/
RUN npm run build:shared

# ---- 5. Copy frontend source (will be overridden by bind mount in dev) ----
COPY packages/frontend/ ./packages/frontend/

WORKDIR /app/packages/frontend

EXPOSE 5173

# Vite dev server: --host 0.0.0.0 allows access from outside the container
CMD ["npx", "vite", "--host", "0.0.0.0"]